# OS files
.DS_Store
Thumbs.db

# Environment & secrets
.env
*.env
.env.*
*.pem
*.key
# OAuth tokens / service accounts / secrets (regardless of extension)
client_secret*.json
youtube_token*.json
*service-account*.json
pending_verifier*.json
pending_flow*.pkl
google_token*.json
auth.json
*_secret*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Regenerable Shorts render artifacts (frames + rendered mp4). The QUEUE is the
# state of record (business/hca-daily/shorts/queue.json); these can be rebuilt
# by hca_short_factory.py, so they do not belong in version control.
business/hca-daily/shorts/builds/

# Node
node_modules/

# Logs & temp
*.log
logs/
tmp/
temp/

# Large media (move to Cloudflare R2 later)
*.mp4
*.mov
*.zip
*.tar.gz

# --- Licensed stock imagery: metadata yes, binaries no -------------------
# The photos in business/hca-daily/worker/assets/img/ come from Pexels under the
# Pexels License. Serving them on our own website is the licensed use; publishing
# unaltered copies into a PUBLIC repo is redistribution, which that licence does
# not grant. Keep CREDITS.md and manifest.json in version control (so the licence
# trail and the source URLs are auditable) and keep the image files out.
business/hca-daily/worker/assets/img/*.jpg
business/hca-daily/worker/assets/img/*.jpeg
business/hca-daily/worker/assets/img/*.png
business/hca-daily/worker/assets/img/*.webp

# Hermes / local
*.session
*.session-journal
hermes_state.db

# IDE
.vscode/
.idea/
# Git credential store (never commit)
.git-credentials
.gitconfig.local
.dev.vars
.dev.vars.*
wrangler.toml.local

# Cloudflare Workers build artifacts
.wrangler/
node_modules/
dist/
.stripe.env

# --- Agent profile data must never be published -------------------------
# /data is the repo root, so profiles/ sits inside it. It contains session
# databases, request dumps (with live API keys in Authorization headers),
# caches, gateway locks and vendored site-packages. None of it belongs in
# a public repo.
profiles/
request_dump_*.json
**/request_dump_*.json
*.db-wal
*.db-shm
gateway.lock
gateway.pid
gateway_state.json

# Key rotation backups (contain live keys)
.openrouter-key-backup-*.txt
