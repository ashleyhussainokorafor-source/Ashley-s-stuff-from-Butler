{
  "name": "hca-daily",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "kv_namespaces": [
    { "binding": "LEADS", "id": "048d56b2542343939b4822283e77888b" }
  ],
  "observability": {
    "enabled": true
  }
}
